# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL (Render PostgreSQL, Neon, Supabase, or Local)
DATABASE_URL="postgresql://user:password@hostname:5432/reachinbox_db?sslmode=require"

# Redis (Render Redis, Upstash Redis, Redis Cloud, or Local)
REDIS_URL="rediss://default:password@hostname:6379"

# Elasticsearch (Elastic Cloud, Bonsai, or Local)
ELASTICSEARCH_NODE="https://your-elasticsearch-endpoint:9200"
ELASTICSEARCH_API_KEY="your-api-key"
# Alternatively for username/password:
# ELASTICSEARCH_USERNAME="elastic"
# ELASTICSEARCH_PASSWORD="your-password"

# JWT Authentication
JWT_SECRET="reachinbox_super_secret_jwt_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# Slack OAuth Credentials
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"
SLACK_REDIRECT_URI="http://localhost:5000/api/slack/callback"

# BullMQ & Throttling Defaults
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT_PER_SENDER=200

# Ethereal Email SMTP Credentials (Generated via nodemailer.createTestAccount() or pre-configured)
ETHEREAL_USER="ethereal_user@ethereal.email"
ETHEREAL_PASS="ethereal_password"
